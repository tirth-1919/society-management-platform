# Application Configuration
FLASK_APP=cli.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Existing society used by the single-society Admin portal (for example Sunrise Heights).
# Required when the database contains more than one society.
SINGLE_SOCIETY_ID=

# Database Configuration (SQLite for local dev, PostgreSQL/MySQL for production)
DATABASE_URL=sqlite:///society_saas.db

# Payment Provider Keys (Razorpay / Cashfree / PayU / Mock)
PAYMENT_PROVIDER=Mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET: Get from Razorpay Dashboard -> Webhooks -> Secret
# Required for secure server-side webhook signature verification
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# OTP & Notification Services
OTP_EXPIRY_MINUTES=5
NOTIFICATION_PROVIDER=Console  # Options: Console, SMTP, Twilio, Mock

# Backup Storage Path
BACKUP_DIR=instance/backups
DOCUMENT_STORAGE_DIR=instance/documents

# Event photo gallery limits. Set event/storage values to 0 to disable those limits.
EVENT_PHOTO_MAX_SIZE_MB=10
EVENT_PHOTO_MAX_PER_UPLOAD=10
EVENT_PHOTO_MAX_PER_USER_EVENT=50
EVENT_PHOTO_MAX_EVENT_TOTAL=0
EVENT_PHOTO_STORAGE_QUOTA_MB=0
