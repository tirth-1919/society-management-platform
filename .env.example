# Application Configuration
FLASK_APP=cli.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Database Configuration (SQLite for local dev, PostgreSQL/MySQL for production)
DATABASE_URL=sqlite:///society_saas.db

# Payment Provider Keys (Razorpay / Cashfree / PayU / Mock)
PAYMENT_PROVIDER=Mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# OTP & Notification Services
OTP_EXPIRY_MINUTES=5
NOTIFICATION_PROVIDER=Console  # Options: Console, SMTP, Twilio, Mock

# Backup Storage Path
BACKUP_DIR=instance/backups
DOCUMENT_STORAGE_DIR=instance/documents
